{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.mambabuilt/mcp-link-in-bio-newsletter-checker",
  "description": "Follow a creator bio link and report the newsletter, what they sell, and the contact emails.",
  "version": "1.0.1",
  "repository": {
    "url": "https://github.com/mambalabsdev/mcp-link-in-bio-newsletter-checker",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@mambalabsdev/mcp-link-in-bio-newsletter-checker",
      "version": "1.0.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "APIFY_TOKEN",
          "description": "Apify API token from https://console.apify.com/account/integrations",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
